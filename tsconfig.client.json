{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/client",
    "outDir": "lib/types/client",
    "skipLibCheck": true
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
